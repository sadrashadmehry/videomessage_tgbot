# Get this from @BotFather on Telegram (/newbot)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- Optional overrides (defaults shown) ---

# Output side length in pixels; the video note is always VIDEO_NOTE_SIZE x
# VIDEO_NOTE_SIZE. Telegram's own clients typically use 384.
VIDEO_NOTE_SIZE=384

# Telegram video messages (video notes) top out at 60 seconds; longer
# source videos are trimmed to this many seconds from the start.
MAX_VIDEO_NOTE_DURATION=60

# Bot upload policy. Public Telegram downloads have a separate 20 MB ceiling.
MAX_DOWNLOAD_SIZE_MB=12
DAILY_REQUEST_LIMIT=10

TEMP_DIR=./data/tmp
# User history and Telegram media references; video bytes are not kept here.
DATABASE_PATH=./data/bot.sqlite3
TEMP_SESSION_TTL_MINUTES=120
LOG_LEVEL=INFO

# Override if ffmpeg/ffprobe aren't on PATH
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Worker-first routing. Leave WORKER_URL empty for proxy-only/direct operation.
WORKER_URL=
WORKER_SECRET=
FALLBACK_PROXY_URL=

# Enables native round GIFs through MTProto. Obtain your own app credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
